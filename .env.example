# Copy to .env.dev and .env.prod (both git-ignored). Read at build time by envied (lib/core/config/env.dart).
# API base, including /api/v1. Android emulator: http://10.0.2.2:8787/api/v1 (localhost = the emulator).
API_BASE_URL=http://localhost:8787/api/v1
# Sent as Origin on writes - the API's CSRF gate needs an allow-listed origin.
# Dev: http://localhost:4321 (allowed when ENVIRONMENT != production). Prod: https://nubisport.hafizbahtiar.com
WEB_ORIGIN=http://localhost:4321
# true = in-memory mock repositories, no API calls. false = real API. Rebuild after changing.
IS_MOCK=false
